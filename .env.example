# DriveEasy settings. Copy to .env.local and fill in. Never commit real values.
# Swapping a local stand-in for a cloud service = changing these settings only.

# ---- App ----
APP_URL=http://localhost:3000

# ---- Database (local PostgreSQL 18 on port 5433; later: cloud Postgres URL) ----
DATABASE_URL=postgres://driveeasy:<password>@localhost:5433/driveeasy_dev
TEST_DATABASE_URL=postgres://driveeasy:<password>@localhost:5433/driveeasy_test

# ---- Authentication (Better Auth, email + password) ----
BETTER_AUTH_SECRET=<random 32+ byte string>
BETTER_AUTH_URL=http://localhost:3000

# ---- Payments: "fake" (local) | "stripe" (future) ----
PAYMENT_PROVIDER=fake
PAYMENT_WEBHOOK_URL=http://localhost:3000/api/webhooks/payments
PAYMENT_WEBHOOK_SECRET=<random string>
# Fake provider only
FAKE_PAYMENTS_STATE_FILE=.local/fake-payments.json
FAKE_PAYMENTS_DUPLICATE_WEBHOOKS=false
# Stripe (future)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- File uploads: "local" (private folder) | "s3" (future, any S3-compatible) ----
STORAGE_PROVIDER=local
LOCAL_UPLOADS_DIR=storage/uploads
# S3 / R2 / etc. (future)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Scheduled jobs: "local" (pnpm job ...) | "cron" (future cloud cron) ----
SCHEDULER_PROVIDER=local
# Shared secret a cloud cron service will send when triggering jobs (future)
CRON_SECRET=

# ---- Email (future; needed for password reset / verification) ----
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_API_KEY=
